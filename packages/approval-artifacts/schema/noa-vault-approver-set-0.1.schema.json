{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noatrust.com/schema/noa-vault-approver-set-0.1.schema.json",
  "title": "NOA Vault Approver Set",
  "description": "Owner-root-only statement. Domain NOA-VaultApproverSet-v0.1-sig. Keys use canonical standard base64 DER SPKI; TLS pins hash DER SPKI bytes. Schema validation does not install authority. See vault-verification.md for root pin, chain, lifetime, key uniqueness and custody checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec",
    "tenant",
    "vaultId",
    "version",
    "previousSetHash",
    "issuedAt",
    "notBefore",
    "expiresAt",
    "keyManifestHash",
    "gateKeys",
    "guardKey",
    "approvers",
    "probe",
    "liftSuspensions",
    "clockSkewSeconds",
    "sig"
  ],
  "properties": {
    "spec": {
      "const": "noa.vault-approver-set/0.1"
    },
    "tenant": {
      "type": "string",
      "pattern": "^.{1,256}$"
    },
    "vaultId": {
      "type": "string",
      "pattern": "^.{1,128}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "previousSetHash": {
      "oneOf": [
        {
          "$ref": "noa-hold-0.1.schema.json#/$defs/hash256"
        },
        {
          "type": "null"
        }
      ]
    },
    "issuedAt": {
      "$ref": "noa-hold-0.1.schema.json#/$defs/rfc3339"
    },
    "notBefore": {
      "$ref": "noa-hold-0.1.schema.json#/$defs/rfc3339"
    },
    "expiresAt": {
      "$ref": "noa-hold-0.1.schema.json#/$defs/rfc3339"
    },
    "keyManifestHash": {
      "$ref": "noa-hold-0.1.schema.json#/$defs/hash256"
    },
    "gateKeys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kid",
          "publicKey",
          "roles",
          "standby",
          "tlsClientSpki"
        ],
        "properties": {
          "kid": {
            "type": "string",
            "pattern": "^.{1,128}$"
          },
          "publicKey": {
            "type": "string",
            "pattern": "^(?=.{4,}$)(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "hold-signer",
                "execution-signer"
              ]
            }
          },
          "standby": {
            "type": "boolean"
          },
          "tlsClientSpki": {
            "$ref": "noa-hold-0.1.schema.json#/$defs/hash256"
          }
        }
      }
    },
    "guardKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kid",
        "publicKey"
      ],
      "properties": {
        "kid": {
          "type": "string",
          "pattern": "^.{1,128}$"
        },
        "publicKey": {
          "type": "string",
          "pattern": "^(?=.{4,}$)(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    },
    "approvers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kid",
          "publicKey",
          "deviceId",
          "custody",
          "cosignPublicKey",
          "attestationDigest",
          "joinHash"
        ],
        "properties": {
          "kid": {
            "type": "string",
            "pattern": "^.{1,128}$"
          },
          "publicKey": {
            "type": "string",
            "pattern": "^(?=.{4,}$)(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          },
          "deviceId": {
            "type": "string",
            "pattern": "^.{1,128}$"
          },
          "custody": {
            "enum": [
              "software-native",
              "hardware-attested"
            ]
          },
          "cosignPublicKey": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^(?=.{4,}$)(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "attestationDigest": {
            "oneOf": [
              {
                "$ref": "noa-hold-0.1.schema.json#/$defs/hash256"
              },
              {
                "type": "null"
              }
            ]
          },
          "joinHash": {
            "$ref": "noa-hold-0.1.schema.json#/$defs/hash256"
          }
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kid",
        "tlsClientSpki"
      ],
      "properties": {
        "kid": {
          "type": "string",
          "pattern": "^.{1,128}$"
        },
        "tlsClientSpki": {
          "$ref": "noa-hold-0.1.schema.json#/$defs/hash256"
        }
      }
    },
    "liftSuspensions": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kid",
          "publicKeyHash"
        ],
        "properties": {
          "kid": {
            "type": "string",
            "pattern": "^.{1,128}$"
          },
          "publicKeyHash": {
            "$ref": "noa-hold-0.1.schema.json#/$defs/hash256"
          }
        }
      }
    },
    "clockSkewSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60
    },
    "sig": {
      "$ref": "noa-hold-0.1.schema.json#/$defs/sig"
    }
  }
}
