{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noatrust.com/schema/noa-vault-authority-bundle-0.1.schema.json",
  "title": "NOA Vault Authority Bundle",
  "description": "Unsigned carrier; no trust anchors, set or policy are accepted from it. References resolve by schema $id, including the unchanged receipt schema supplied by noa-receipt. This profile carries ledger-transfer and zero-effect probe parameters only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec",
    "hold",
    "deferredReceipt",
    "approvalReceipt",
    "decisions",
    "cosignatures",
    "grant",
    "parameters"
  ],
  "properties": {
    "spec": {
      "const": "noa.vault-authority-bundle/0.1"
    },
    "hold": {
      "$ref": "noa-hold-0.1.schema.json"
    },
    "deferredReceipt": {
      "$ref": "noa-receipt-0.1.schema.json"
    },
    "approvalReceipt": {
      "$ref": "noa-receipt-0.1.schema.json"
    },
    "decisions": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "noa-decision-0.1.schema.json"
      }
    },
    "cosignatures": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "noa-device-cosignature-0.1.schema.json"
      }
    },
    "grant": {
      "$ref": "noa-execution-grant-0.1.schema.json"
    },
    "parameters": {
      "oneOf": [
        {
          "$ref": "#/$defs/ledgerParameters"
        },
        {
          "$ref": "#/$defs/probeParameters"
        }
      ]
    }
  },
  "$defs": {
    "ledgerParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "fromAccount",
        "ledger",
        "salt",
        "toAccount",
        "unit"
      ],
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,14}$"
        },
        "fromAccount": {
          "type": "string",
          "pattern": "^[a-z](?:[a-z0-9-]{0,62}[a-z0-9])?$"
        },
        "ledger": {
          "type": "string",
          "pattern": "^[a-z](?:[a-z0-9-]{0,62}[a-z0-9])?$"
        },
        "salt": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "toAccount": {
          "type": "string",
          "pattern": "^[a-z](?:[a-z0-9-]{0,62}[a-z0-9])?$"
        },
        "unit": {
          "const": "XTS"
        }
      }
    },
    "probeParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vault",
        "run"
      ],
      "properties": {
        "vault": {
          "type": "string",
          "pattern": "^[a-z](?:[a-z0-9-]{0,62}[a-z0-9])?$"
        },
        "run": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      }
    }
  }
}
