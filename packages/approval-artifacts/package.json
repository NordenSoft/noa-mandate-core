{
  "name": "noa-approval-artifacts",
  "version": "0.1.0",
  "description": "NOA approval protocol artifacts: frozen JSON schemas, Ed25519/refHash conventions, a zero-dependency reference verifier, and positive and rejection conformance vectors for holds, decisions, manifests, delegations, grants, resolution, pairing, and encrypted display artifacts.",
  "keywords": [
    "ai-agent",
    "governance",
    "approval",
    "hpke",
    "ed25519",
    "jcs",
    "rfc8785",
    "conformance",
    "json-schema"
  ],
  "homepage": "https://noatrust.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/NordenSoft/noa-mandate-core.git",
    "directory": "packages/approval-artifacts"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./schema/*": "./schema/*"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/src",
    "schema",
    "conformance",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "gen:vectors": "npm run build && node dist/scripts/gen-vectors.js",
    "test": "npm run build && node dist/scripts/gen-vectors.js && node --test dist/test/*.test.js test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "typescript": "^5.6.0"
  }
}
